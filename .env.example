# Agency Portfolio Platform — environment template
# Copy to .env.local for local development. Never commit real secrets.

NEXT_PUBLIC_APP_NAME="Agency"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase data + authentication.
# Local values are printed by: npm run db:status
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# M10 booking webhook verification. Use the secret configured in your Cal.com webhook.
CALCOM_WEBHOOK_SECRET=""


# M12 transactional email / notification system.
# Provider secrets are server-only. Never expose them through NEXT_PUBLIC_* variables.
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
EMAIL_FROM=""
EMAIL_REPLY_TO=""

# Non-production safety:
# Recommended: redirect every outbound message to one controlled inbox.
EMAIL_DEV_REDIRECT_TO=""
# Or allow only explicit comma-separated test recipients.
EMAIL_DEV_ALLOWLIST=""
# Keep false unless you intentionally want development/staging to send to real recipients.
EMAIL_ALLOW_EXTERNAL_IN_NON_PROD="false"

# Optional extra internal recipients, comma-separated. Admin UI recipients are merged with this list.
NOTIFICATION_ADMIN_EMAILS=""


# M13 n8n automation engine.
N8N_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET=""
N8N_CALLBACK_SECRET=""
AUTOMATION_DISPATCH_SECRET=""


# M15 public AI assistant.
# Server-only. Never expose this through NEXT_PUBLIC_*.
OPENAI_API_KEY=""
# Used only to hash public request fingerprints for rate limiting.
AI_REQUEST_HASH_SECRET=""


# M17 analytics and conversion tracking.
# internal = first-party event table only
# plausible = first-party event table + Plausible browser provider
# ga4 = first-party event table + Google Analytics browser provider
# none = disable public browser analytics
ANALYTICS_PROVIDER="internal"
ANALYTICS_ENVIRONMENT="development"
ANALYTICS_CONSENT_REQUIRED="true"
ANALYTICS_ENABLE_IN_NON_PRODUCTION="false"
ANALYTICS_EXTERNAL_DASHBOARD_URL=""
PLAUSIBLE_DOMAIN=""
GA_MEASUREMENT_ID=""


# M18 security / abuse prevention.
# Turnstile is optional locally. In production configure both keys and set
# TURNSTILE_REQUIRED=true to fail closed on protected public lead actions.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
TURNSTILE_REQUIRED="false"

# Long independent HMAC secret used to hash request fingerprints before storage.
SECURITY_HASH_SECRET=""

# Optional comma-separated preview/staging origins allowed for same-origin mutation checks.
TRUSTED_APP_ORIGINS=""


# M19 release/observability metadata.
APP_RELEASE="local"
LOG_LEVEL="info"

# M19 backup scripts. Server/CI only; never expose these in NEXT_PUBLIC_* variables.
BACKUP_DATABASE_URL=""
