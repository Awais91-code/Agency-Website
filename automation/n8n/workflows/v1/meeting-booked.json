          {
            "node": "Respond Accepted",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Respond Accepted": {
      "main": [
        [
          {
            "node": "Report Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
