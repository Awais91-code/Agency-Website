{
  "name": "agency-portfolio-platform",
  "version": "0.19.4",
  "private": true,
  "description": "Modern agency portfolio, lead engine, CRM front end, client portal and automation platform.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "db:check": "node scripts/check-migrations.mjs",
    "auth:check": "node scripts/check-auth-boundaries.mjs",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run db:check && npm run auth:check && npm run media:check && npm run marketing:check && npm run services:check && npm run work:check && npm run quote:check && npm run crm:check && npm run booking:check && npm run cms:check && npm run notifications:check && npm run automation:check && npm run portal:check && npm run ai:check && npm run ai:guardrails && npm run blog:check && npm run analytics:check && npm run security:check && npm run security:scan && npm run release:check && npm run backup:test && npm run build",
    "media:check": "node scripts/check-media-boundaries.mjs",
    "marketing:check": "node scripts/check-marketing-pages.mjs",
    "services:check": "node scripts/check-services-module.mjs",
    "work:check": "node scripts/check-case-studies-module.mjs",
    "quote:check": "node scripts/check-project-brief-module.mjs",
    "auth:bootstrap-admin": "node --env-file=.env.local scripts/bootstrap-local-admin.mjs",
    "auth:diagnose": "node --env-file=.env.local scripts/bootstrap-local-admin.mjs --diagnose",
    "crm:check": "node scripts/check-lead-crm-module.mjs",
    "booking:check": "node scripts/check-booking-module.mjs",
    "cms:check": "node scripts/check-admin-cms-module.mjs",
    "notifications:check": "node scripts/check-notifications-module.mjs",
    "automation:check": "node scripts/check-automation-module.mjs",
    "portal:check": "node scripts/check-client-portal-module.mjs",
    "portal:isolation": "node --env-file=.env.local scripts/test-client-portal-isolation.mjs",
    "ai:check": "node scripts/check-ai-assistant-module.mjs",
    "ai:guardrails": "node scripts/test-ai-guardrails.mjs",
    "ai:cleanup": "node --env-file=.env.local scripts/cleanup-ai-retention.mjs",
    "blog:check": "node scripts/check-blog-seo-module.mjs",
    "analytics:check": "node scripts/check-analytics-module.mjs",
    "security:check": "node scripts/check-security-hardening.mjs",
    "security:scan": "node scripts/scan-secrets.mjs",
    "security:rls": "node --env-file=.env.local scripts/test-security-rls.mjs",
    "security:retention": "node --env-file=.env.local scripts/run-security-retention.mjs",
    "security:deps": "npm audit --audit-level=high",
    "release:check": "node scripts/check-release-operations.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "perf:check": "node scripts/performance-budget.mjs",
    "ci:env": "node scripts/write-local-supabase-env.mjs",
    "e2e:critical": "node --env-file=.env.local scripts/e2e-critical-flows.mjs",
    "backup:create": "node --env-file=.env.local scripts/create-backup-bundle.mjs",
    "backup:verify": "node scripts/verify-backup-bundle.mjs",
    "backup:restore-storage": "node scripts/restore-storage-bundle.mjs",
    "backup:test": "node scripts/test-backup-cli.mjs && node scripts/test-backup-manifest.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5",
    "resend": "6.28.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.28.0",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
